# Copy to .env for LOCAL runs only. .env is gitignored. In GitHub, set these as Secrets.
# Never put real values in this example file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=service-role-key-goes-here

# Optional (later phases)
FINNHUB_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 1 locally to print tickers/values in logs. NEVER set this in GitHub Actions.
LOCAL_DEBUG=0
